{
  "name": "@card-architect/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@card-architect/backup-core": "workspace:*",
    "@card-architect/defaults": "workspace:*",
    "@card-architect/import-core": "workspace:*",
    "@character-foundry/character-foundry": "0.6.0",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "axios": "1.20.0",
    "better-sqlite3": "13.0.3",
    "comfy-ui-client": "^0.1.2",
    "dotenv": "17.4.2",
    "fastembed": "2.1.0",
    "fastify": "5.12.5",
    "fflate": "0.8.3",
    "form-data": "4.0.6",
    "nanoid": "6.0.1",
    "pdf-parse": "2.4.5",
    "sharp": "0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@vitest/ui": "4.1.11",
    "pino-pretty": "^13.1.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
