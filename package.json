{
  "name": "card-architect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Character Architect - CCv2/CCv3 character card editor",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:fresh": "pnpm build:packages && pnpm dev",
    "dev:api": "pnpm --filter @card-architect/api run dev",
    "dev:web": "pnpm --filter @card-architect/web run dev",
    "build": "pnpm build:packages && pnpm build:apps",
    "build:packages": "pnpm --filter @card-architect/backup-core run build && pnpm --filter @card-architect/defaults run build && pnpm --filter @card-architect/import-core run build && pnpm --filter @card-architect/plugins run build",
    "build:apps": "pnpm build:api && pnpm build:web",
    "build:api": "pnpm --filter @card-architect/api run build",
    "build:web": "pnpm --filter @card-architect/web run build",
    "build:web:full": "VITE_DEPLOYMENT_MODE=full pnpm run build:web",
    "build:web:light": "VITE_DEPLOYMENT_MODE=light pnpm run build:web",
    "build:web:static": "VITE_DEPLOYMENT_MODE=static pnpm run build:web",
    "test": "pnpm --recursive --if-present run test",
    "test:static-smoke": "pnpm build:web:static && node scripts/static-browser-smoke.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "test:e2e:fixtures": "playwright test -c e2e/playwright.config.ts golden-fixtures.spec.ts",
    "test:e2e:export": "playwright test -c e2e/playwright.config.ts golden-fixtures.spec.ts",
    "test:e2e:ui-elements": "playwright test -c e2e/playwright.config.ts ui-elements.spec.ts",
    "test:e2e:parity": "playwright test -c e2e/playwright.config.ts parity.spec.ts",
    "test:e2e:cross-platform": "playwright test -c e2e/playwright.config.ts cross-platform.spec.ts",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint .",
    "type-check": "pnpm --recursive --if-present run type-check",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist",
    "cf:deploy": "wrangler deploy",
    "cf:deploy:dev": "wrangler deploy --env dev",
    "docker:smoke": "sh scripts/docker-smoke.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0 <12"
  },
  "dependencies": {
    "@character-foundry/character-foundry": "0.6.0"
  }
}
